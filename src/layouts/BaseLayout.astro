---
import '@fontsource-variable/public-sans';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { practice } from '../data/practice';
import { serviceGroups } from '../data/services';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks beyond the base MedicalClinic schema. */
  schema?: object[];
}

const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Private concept demo: keep every page out of search engines. robots.txt and
// the Cloudflare _headers file say the same; flip all three at launch.
const ROBOTS = 'noindex, nofollow';

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: practice.name,
  url: Astro.site?.toString(),
  image: practice.assets.building.src,
  telephone: '+1-325-695-2020',
  faxNumber: '+1-325-695-2326',
  // schema.org has no ophthalmology value; surgical plus optometric is the
  // closest valid pair, and knowsAbout carries the specifics.
  medicalSpecialty: ['https://schema.org/Surgical', 'https://schema.org/Optometric'],
  knowsAbout: serviceGroups.flatMap((group) => group.services.map((s) => s.title)),
  address: {
    '@type': 'PostalAddress',
    streetAddress: practice.address.street,
    addressLocality: practice.address.city,
    addressRegion: practice.address.state,
    postalCode: practice.address.zip,
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: practice.geo.latitude, longitude: practice.geo.longitude },
  // Friday's midday break isn't modeled; the visible hours carry it.
  openingHoursSpecification: practice.hours
    .filter((h) => h.opens && h.closes)
    .map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.dayCodes, opens: h.opens, closes: h.closes })),
  areaServed: practice.serviceArea.map((c) => ({ '@type': 'City', name: c })),
  sameAs: practice.profiles,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={ROBOTS} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={practice.name} />
    <meta property="og:image" content={practice.assets.building.src} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {schema.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="flex min-h-[100dvh] flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-navy-900 focus:px-4 focus:py-3 focus:text-white"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
