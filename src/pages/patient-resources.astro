---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { practice } from '../data/practice';
const resources=[
 {title:'Call for an appointment',body:'Talk with the office team about scheduling and the right type of visit.',href:practice.phone.href,icon:'ph:phone'},
 {title:'Patient forms',body:'Open the forms and policies currently published by the practice.',href:practice.links.patientForms,icon:'ph:file-text'},
 {title:'Pay your bill',body:'Continue to the practice’s third-party payment service.',href:practice.links.payBill,icon:'ph:credit-card'},
 {title:'Financing options',body:'Review CareCredit and other financing information published by the practice.',href:practice.links.financing,icon:'ph:wallet'},
 {title:'Directions and hours',body:'Plan your visit to 2120 Antilley Road in Abilene.',href:'/locations/',icon:'ph:map-pin'},
 {title:'Medical records',body:'Call the office for the current authorization and records-release process.',href:practice.phone.href,icon:'ph:files'},
];
---
<BaseLayout title="Patient Resources | Abilene Eye Institute" description="Appointments, forms, bill pay, financing, directions, and practical visit information for Abilene Eye Institute patients.">
  <section class="bg-white"><div class="mx-auto max-w-5xl px-4 py-16 sm:px-6"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-sage-700">Patient hub</p><h1 class="mt-3 font-serif text-5xl font-semibold text-navy-900">The practical things, easy to find</h1><p class="mt-5 max-w-2xl text-lg text-ink-soft">Use the current practice resources below. This demonstration site does not collect patient or medical information.</p></div></section>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6"><div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{resources.map(r=><a href={r.href} class="rounded-xl border border-sand-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-sage-600 hover:shadow-lg"><Icon name={r.icon} class="h-8 w-8 text-sage-700" /><h2 class="mt-5 font-serif text-2xl font-semibold text-navy-900">{r.title}</h2><p class="mt-2 text-ink-soft">{r.body}</p><span class="mt-5 inline-block font-semibold text-navy-700">Continue →</span></a>)}</div>
    <div class="mt-10 rounded-xl bg-navy-50 p-7"><h2 class="font-serif text-2xl font-semibold text-navy-900">Protecting your information</h2><p class="mt-3 text-ink-soft">Do not send medical details through ordinary website channels. Call <a href={practice.phone.href} class="font-semibold text-navy-700 underline">{practice.phone.display}</a> or use a secure system supplied directly by the practice.</p></div>
  </section>
</BaseLayout>
