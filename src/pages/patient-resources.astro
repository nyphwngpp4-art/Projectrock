---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { practice } from '../data/practice';

const secure = [
  {
    title: 'Request an Appointment',
    body: 'Ask for a visit online, or simply call the office.',
    href: practice.links.requestAppointment,
    icon: 'ph:calendar-plus',
  },
  {
    title: 'Patient Portal',
    body: 'Messages, visit summaries, and records through the practice’s secure system.',
    href: practice.links.patientPortal,
    icon: 'ph:lock-simple',
  },
  {
    title: 'Pay Your Bill',
    body: 'Pay securely through the practice’s payment platform.',
    href: practice.links.payBill,
    icon: 'ph:credit-card',
  },
];

const informational = [
  {
    title: 'Patient forms',
    body: 'New patient paperwork will be linked here once the practice confirms current forms. Where a secure digital option exists, it will be offered alongside any PDF.',
  },
  {
    title: 'Medical record requests',
    body: 'Records are released through the front office with a signed authorization. Call the office and our team will walk you through the process.',
  },
  {
    title: 'Prescription questions',
    body: 'For refills of eye drops or other prescriptions, call the office with your pharmacy information, or use the patient portal.',
  },
  {
    title: 'Preparing for surgery',
    body: 'Your surgical coordinator gives you specific instructions for your procedure: when to arrive, what to bring, and arrangements for a driver. Call any time a detail is unclear.',
  },
];
---

<BaseLayout
  title="Patient Resources | Abilene Eye Institute"
  description="Appointments, patient portal, bill pay, forms, medical records, prescriptions, and surgery preparation for patients of Abilene Eye Institute."
>
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 pb-12 pt-12 sm:px-6 lg:pt-16">
      <h1 class="font-serif text-4xl font-semibold leading-tight text-navy-900 sm:text-5xl">
        Patient resources
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">
        Everything you need between visits, with secure tools clearly separated from ordinary
        information pages.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <SectionHeading
      title="Secure tools"
      intro="These open the practice's protected external systems, separate from this website."
    />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        secure.map((s) => (
          <a href={s.href} class="rounded-lg border border-sand-200 bg-white p-6 hover:border-navy-600">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-sage-50 text-sage-700" aria-hidden="true">
              <Icon name={s.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 text-lg font-semibold text-navy-900">{s.title}</h3>
            <p class="mt-1.5 text-ink-soft">{s.body}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-sage-700">
              <Icon name="ph:arrow-square-out" class="h-4 w-4" aria-hidden="true" />
              Opens a secure external system
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <SectionHeading title="Practical information" />
      <div class="mt-8 space-y-5">
        {
          informational.map((item) => (
            <div class="rounded-lg border border-sand-200 p-6">
              <h3 class="text-lg font-semibold text-navy-900">{item.title}</h3>
              <p class="mt-2 text-ink-soft">{item.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 rounded-md bg-sand-100 p-5 text-ink-soft">
        Please do not send medical details through any general contact channel on this website. For
        anything involving your care, call
        <a href={practice.phone.href} class="font-semibold text-navy-700 underline">{practice.phone.display}</a>
        or use the secure patient portal.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
