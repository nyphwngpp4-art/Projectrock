---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { practice } from '../data/practice';

const resources = [
  {
    title: 'Call for an appointment',
    body: 'Talk with the office team about scheduling and the right type of visit.',
    href: practice.links.call,
    icon: 'ph:phone',
    note: `Calls ${practice.phone.display}`,
  },
  {
    title: 'Patient forms',
    body: 'Open the forms and policies the practice currently publishes.',
    href: practice.links.patientForms,
    icon: 'ph:file-text',
    note: "Opens the practice's current website",
  },
  {
    title: 'Pay your bill',
    body: 'Pay through the practice’s payment service, QuickClick.',
    href: practice.links.payBill,
    icon: 'ph:credit-card',
    note: 'Opens a secure third-party payment site',
  },
  {
    title: 'Financing options',
    body: 'CareCredit and First Financial Bank financing, as listed by the practice.',
    href: practice.links.financing,
    icon: 'ph:wallet',
    note: "Opens the practice's current website",
  },
  {
    title: 'Hours and directions',
    body: `Plan your visit to ${practice.address.street} in ${practice.address.city}.`,
    href: '/locations/',
    icon: 'ph:map-pin',
  },
  {
    title: 'Medical records',
    body: 'Records are released with a signed authorization. Call the office for the current process.',
    href: practice.links.call,
    icon: 'ph:files',
    note: `Calls ${practice.phone.display}`,
  },
];

const practical = [
  {
    title: 'Prescription questions',
    body: 'For refills of eye drops or other prescriptions, call the office with your pharmacy information.',
  },
  {
    title: 'Preparing for surgery',
    body: 'Your surgical coordinator gives you specific instructions: when to arrive, what to bring, and arranging a driver. Call any time a detail is unclear.',
  },
  {
    title: 'Coming from out of town',
    body: 'Tell the scheduler where you are driving from so appointments can be grouped to save you trips.',
  },
];
---

<BaseLayout
  title="Patient Resources | Abilene Eye Institute"
  description="Appointments, forms, bill pay, financing, directions, and practical visit information for Abilene Eye Institute patients."
>
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sage-700">Patient hub</p>
      <h1 class="mt-3 font-serif text-5xl font-semibold text-navy-900">The practical things, easy to find</h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">
        Everything you need between visits. Links that leave this site say so.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        resources.map((r) => (
          <a
            href={r.href}
            class="rounded-xl border border-sand-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-sage-600 hover:shadow-lg"
          >
            <Icon name={r.icon} class="h-8 w-8 text-sage-700" aria-hidden="true" />
            <h2 class="mt-5 font-serif text-2xl font-semibold text-navy-900">{r.title}</h2>
            <p class="mt-2 text-ink-soft">{r.body}</p>
            {r.note && <p class="mt-4 text-sm font-medium text-sage-700">{r.note}</p>}
          </a>
        ))
      }
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        practical.map((item) => (
          <div class="rounded-lg border border-sand-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-navy-900">{item.title}</h2>
            <p class="mt-2 text-ink-soft">{item.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-xl bg-navy-50 p-7">
      <h2 class="font-serif text-2xl font-semibold text-navy-900">Protecting your information</h2>
      <p class="mt-3 text-ink-soft">
        Please do not send medical details through ordinary website channels or email. For anything
        about your care, call <a href={practice.links.call} class="font-semibold text-navy-700 underline">{practice.phone.display}</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
