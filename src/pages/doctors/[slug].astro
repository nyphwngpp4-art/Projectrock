---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { doctors } from '../../data/doctors';
import { practice } from '../../data/practice';

export function getStaticPaths() {
  return doctors.map((doctor) => ({ params: { slug: doctor.slug }, props: { doctor } }));
}

const { doctor } = Astro.props;
const initials = doctor.name
  .split(' ')
  .filter((w) => w.length > 1)
  .map((w) => w[0])
  .join('');

const physicianSchema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: `${doctor.name}, ${doctor.degree}`,
  medicalSpecialty: doctor.degree === 'MD' ? 'Ophthalmologic' : 'Optometric',
  worksFor: { '@type': 'MedicalClinic', name: practice.name },
};
---

<BaseLayout
  title={`${doctor.name}, ${doctor.degree} | Abilene Eye Institute`}
  description={`${doctor.name}, ${doctor.degree}: ${doctor.role} at Abilene Eye Institute in Abilene, Texas. ${doctor.cardLine}`}
  schema={[physicianSchema]}
>
  <section class="bg-white">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 pb-14 pt-12 sm:px-6 md:grid-cols-[240px_1fr] lg:pt-16">
      <!-- Portrait placeholder: swap for a real headshot; see ASSET-INVENTORY.md -->
      <div
        class="mx-auto flex h-56 w-56 items-center justify-center rounded-lg bg-navy-50 font-serif text-6xl font-semibold text-navy-700 md:mx-0"
        role="img"
        aria-label={`Portrait placeholder for ${doctor.name}, ${doctor.degree}`}
      >
        {initials}
      </div>
      <div>
        <h1 class="font-serif text-4xl font-semibold text-navy-900">
          {doctor.name}, {doctor.degree}
        </h1>
        <p class="mt-2 text-lg font-medium text-sage-700">{doctor.role}</p>
        {doctor.languages && (
          <p class="mt-2 text-ink-soft">Sees patients in {doctor.languages.join(' and ')}.</p>
        )}
        <h2 class="mt-6 text-sm font-semibold uppercase tracking-wider text-ink">Clinical focus</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            doctor.focus.map((f) => (
              <li class="rounded-full bg-sand-100 px-4 py-1.5 font-medium text-navy-800">{f}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1fr_320px]">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-navy-900">About</h2>
        {
          doctor.bio.length > 0 ? (
            doctor.bio.map((p) => <p class="mt-4 text-ink-soft">{p}</p>)
          ) : (
            <p class="mt-4 rounded-md bg-sand-100 p-5 text-ink-soft">
              Biography pending verification with the practice. No details are published here until
              they are confirmed.
            </p>
          )
        }

        <h2 class="mt-10 font-serif text-2xl font-semibold text-navy-900">Education & Training</h2>
        {
          doctor.education.length > 0 ? (
            <ul class="mt-4 space-y-2">
              {doctor.education.map((e) => (
                <li class="flex items-start gap-3">
                  <Icon name="ph:graduation-cap" class="mt-1 h-5 w-5 shrink-0 text-sage-700" aria-hidden="true" />
                  {e}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 rounded-md bg-sand-100 p-5 text-ink-soft">
              Education and training details pending verification with the practice.
            </p>
          )
        }

        <h2 class="mt-10 font-serif text-2xl font-semibold text-navy-900">Credentials & Memberships</h2>
        {
          doctor.credentials.length > 0 ? (
            <ul class="mt-4 space-y-2">
              {doctor.credentials.map((c) => (
                <li class="flex items-start gap-3">
                  <Icon name="ph:seal-check" class="mt-1 h-5 w-5 shrink-0 text-sage-700" aria-hidden="true" />
                  {c}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 rounded-md bg-sand-100 p-5 text-ink-soft">
              Credentials pending verification with the practice. Nothing is listed here that has
              not been confirmed.
            </p>
          )
        }
      </div>

      <aside class="h-fit rounded-lg border border-sand-200 bg-white p-6">
        <h2 class="font-serif text-xl font-semibold text-navy-900">See {doctor.name.split(' ')[0]} {doctor.name.split(' ').at(-1)}, {doctor.degree}</h2>
        <p class="mt-2 text-ink-soft">
          {practice.address.street}<br />
          {practice.address.city}, {practice.address.state} {practice.address.zip}
        </p>
        <a
          href={practice.phone.href}
          class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-md bg-navy-800 px-5 py-3 font-semibold text-white hover:bg-navy-700"
        >
          <Icon name="ph:phone" class="h-5 w-5" aria-hidden="true" />
          Call {practice.phone.display}
        </a>
        <a
          href={practice.links.requestAppointment}
          class="mt-3 inline-flex w-full items-center justify-center rounded-md border-2 border-navy-800 px-5 py-3 font-semibold text-navy-800 hover:bg-navy-50"
        >
          Request Appointment
        </a>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
