---
import BaseLayout from '../layouts/BaseLayout.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Page Not Found | Abilene Eye Institute"
  description="The page you were looking for could not be found."
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <h1 class="font-serif text-4xl font-semibold text-navy-900">We couldn't find that page</h1>
    <p class="mt-4 text-lg text-ink-soft">
      The page may have moved. The links below cover most of what patients look for, or call
      <a href={practice.phone.href} class="font-semibold text-navy-700 underline">{practice.phone.display}</a>
      and we will point you in the right direction.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-md bg-navy-800 px-6 py-3 font-semibold text-white hover:bg-navy-700">Homepage</a>
      <a href="/services/" class="rounded-md border-2 border-navy-800 px-6 py-3 font-semibold text-navy-800 hover:bg-navy-50">Our Services</a>
      <a href="/locations/" class="rounded-md border-2 border-navy-800 px-6 py-3 font-semibold text-navy-800 hover:bg-navy-50">Contact</a>
    </div>
  </section>
</BaseLayout>
