---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { practice } from '../data/practice';

---

<BaseLayout
  title="Location, Hours & Contact | Abilene Eye Institute, Abilene, TX"
  description="Visit Abilene Eye Institute at 2120 Antilley Rd, Abilene, TX. Office hours, phone, directions, and appointment information."
>
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 pb-12 pt-12 sm:px-6 lg:pt-16">
      <h1 class="font-serif text-4xl font-semibold leading-tight text-navy-900 sm:text-5xl">
        Location & contact
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">
        One call reaches our whole team: appointments, billing questions, records, and referrals.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2">
    <div>
      <div class="rounded-lg border border-sand-200 bg-white p-7">
        <h2 class="font-serif text-2xl font-semibold text-navy-900">Abilene Eye Institute</h2>
        <address class="mt-3 text-lg not-italic text-ink-soft">
          {practice.address.street}<br />
          {practice.address.city}, {practice.address.state} {practice.address.zip}
        </address>
        <div class="mt-5 space-y-2 text-lg">
          <p>
            <span class="font-semibold text-navy-900">Phone:</span>
            <a href={practice.links.call} class="font-semibold text-navy-700 underline">{practice.phone.display}</a>
          </p>
          <p class="text-ink-soft">
            <span class="font-semibold text-navy-900">Fax:</span> {practice.fax.display}
          </p>
        </div>
        <a
          href={practice.links.directions}
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-md bg-navy-800 px-5 py-3 font-semibold text-white hover:bg-navy-700"
        >
          <Icon name="ph:map-pin" class="h-5 w-5" aria-hidden="true" />
          Get Directions
        </a>
        <p class="mt-3 text-sm text-ink-soft">
          The clinic and its surgery center share the building on Antilley Road.
        </p>
      </div>

      <div class="mt-6 rounded-lg border border-sand-200 bg-white p-7">
        <h2 class="font-serif text-2xl font-semibold text-navy-900">Office hours</h2>
        <dl class="mt-4 space-y-2 text-lg">
          {
            practice.hours.map((h) => (
              <div class="flex justify-between gap-6">
                <dt class="font-medium text-navy-900">{h.days}</dt>
                <dd class="text-ink-soft">{h.hours}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="mt-6 rounded-lg border-2 border-navy-800 bg-navy-50 p-6">
        <h2 class="font-serif text-xl font-semibold text-navy-900">Urgent eye problems</h2>
        <p class="mt-2">
          Sudden vision loss, injury, or severe pain: call
          <a href={practice.links.call} class="font-semibold underline">{practice.phone.display}</a>
          during office hours or go to the nearest emergency room. In an emergency, call 911.
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <ImagePlaceholder
        label="Interactive map connects at production"
        mark="2120 Antilley Rd"
        markSub="Abilene, Texas 79606"
        class="min-h-72 flex-1"
      />
      <div class="rounded-lg border border-sand-200 bg-white p-7">
        <h2 class="font-serif text-2xl font-semibold text-navy-900">Appointments</h2>
        <p class="mt-3 text-ink-soft">
          The office schedules visits by phone. A general contact form is deliberately not offered:
          questions about your eyes belong in a phone call, not an unsecured web form.
        </p>
        <a
          href={practice.links.call}
          class="mt-5 inline-flex items-center justify-center gap-2 rounded-md border-2 border-navy-800 px-6 py-3 font-semibold text-navy-800 hover:bg-navy-50"
        >
          <Icon name="ph:phone" class="h-5 w-5" aria-hidden="true" />
          Call {practice.phone.display}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <SectionHeading
        title="Traveling from out of town?"
        intro="Many of our patients drive in from surrounding communities. Tell our scheduler where you are coming from and we will group your appointments to save you trips."
      />
      <ul class="mt-7 flex flex-wrap gap-2.5">
        {
          practice.serviceArea.map((city) => (
            <li class="rounded-full bg-sand-100 px-4 py-1.5 font-medium text-navy-800">{city}</li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
