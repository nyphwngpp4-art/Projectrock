---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PathwayCard from '../components/PathwayCard.astro';
import DoctorCard from '../components/DoctorCard.astro';
import CtaBand from '../components/CtaBand.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { practice } from '../data/practice';
import { doctors } from '../data/doctors';
import { featuredServices } from '../data/services';

const pathways = [
  {
    title: 'Cataract Care',
    description: 'Vision getting cloudy or dim? Learn what a cataract evaluation involves and what surgery is really like.',
    href: '/cataract-care/',
    icon: 'ph:eye',
    cta: 'Learn about cataract care',
  },
  {
    title: 'Vision Correction',
    description: 'Interested in depending less on glasses or contacts? Explore LASIK and other options.',
    href: '/vision-correction/',
    icon: 'ph:sparkle',
    cta: 'Explore your options',
  },
  {
    title: 'Medical Eye Care',
    description: 'Ongoing care for glaucoma, diabetic eye disease, macular degeneration, and dry eye.',
    href: '/medical-eye-care/',
    icon: 'ph:first-aid-kit',
    cta: 'See conditions we treat',
  },
  {
    title: 'Existing Patients',
    description: 'Portal access, bill pay, forms, prescriptions, and everything else you need between visits.',
    href: '/patient-resources/',
    icon: 'ph:folder-user',
    cta: 'Go to patient resources',
  },
];

const differentiators = [
  {
    icon: 'ph:map-pin',
    title: 'Surgical care close to home',
    body: 'Medical and surgical eye care in Abilene, so most patients avoid long trips to metro hospitals.',
  },
  {
    icon: 'ph:user-focus',
    title: 'Your surgeon, start to finish',
    body: 'The physician who evaluates you is the physician who treats you and follows your recovery.',
  },
  {
    icon: 'ph:clock-countdown',
    title: 'Decades in the Big Country',
    body: 'An established practice serving Abilene and surrounding communities since 1987.',
  },
];
---

<BaseLayout
  title="Abilene Eye Institute | Eye Doctors & Cataract, LASIK Surgeons in Abilene, TX"
  description="Advanced medical and surgical eye care in Abilene, Texas: cataract surgery, LASIK, glaucoma, and diabetic eye care, close to home for the Big Country."
>
  <!-- Hero: asymmetric split with overlapping credential card -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 pb-16 pt-12 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:pb-24 lg:pt-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sage-700">
          Medical &amp; Surgical Eye Care
        </p>
        <h1 class="mt-4 font-serif text-[2.6rem] font-semibold leading-[1.08] tracking-tight text-navy-900 sm:text-6xl">
          Advanced eye care.<br />Personal attention.<br />Close to home.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft">
          Care for Abilene and the Big Country, coordinated by physicians who know their patients.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={practice.links.requestAppointment}
            class="inline-flex items-center justify-center rounded-md bg-navy-800 px-7 py-3.5 text-lg font-semibold text-white shadow-sm shadow-navy-100 hover:bg-navy-700"
          >
            Request an Appointment
          </a>
          <a
            href="/services/"
            class="inline-flex items-center justify-center rounded-md border-2 border-navy-800 px-7 py-3.5 text-lg font-semibold text-navy-800 hover:bg-navy-50"
          >
            Explore Our Services
          </a>
        </div>
      </div>
      <div class="relative pb-10 lg:pb-12">
        <ImagePlaceholder
          label="Practice photography to be added"
          mark="Est. 1987"
          markSub="Abilene, Texas"
          class="aspect-[4/3] w-full"
        />
        <div
          class="absolute -bottom-0 left-6 right-6 rounded-md border border-sand-200 bg-white px-6 py-4 shadow-lg shadow-navy-900/10 sm:left-10 sm:right-auto"
        >
          <p class="font-serif text-lg font-semibold text-navy-900">Two surgeons. Three optometrists.</p>
          <p class="mt-0.5 text-sm text-ink-soft">One coordinated practice for the Big Country.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Value-framing band: the calm sales layer -->
  <section class="border-y border-sand-200 bg-sand-100">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="max-w-3xl border-l-2 border-sage-600 pl-6 sm:pl-8">
        <p class="font-serif text-2xl leading-snug text-navy-900 sm:text-[1.75rem]">
          Choosing eye surgery is a big decision. It should not require a big-city trip, or a
          website that leaves you guessing.
        </p>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          differentiators.map((d, i) => (
            <div class="border-t border-sand-300 pt-5">
              <p class="font-serif text-sm text-sage-700" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h2 class="mt-2 text-lg font-semibold text-navy-900">{d.title}</h2>
              <p class="mt-1.5 text-ink-soft">{d.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-10 text-sm text-ink-soft/80">
        Founding year and surgical facility details pending confirmation with the practice.
      </p>
    </div>
  </section>

  <!-- Patient-intent pathways -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <SectionHeading
      title="How can we help you today?"
      intro="Start with what you are noticing or what you need. You do not have to know the medical name for it."
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pathways.map((p) => <PathwayCard {...p} />)}
    </div>
  </section>

  <!-- Featured services: pill list, patient language -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <SectionHeading
        title="Care we provide"
        intro="From routine exams to advanced surgery, in plain language."
        align="center"
      />
      <ul class="mx-auto mt-9 flex max-w-4xl flex-wrap justify-center gap-3">
        {
          featuredServices.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-block rounded-full border border-sand-300 bg-sand-50 px-5 py-2.5 font-medium text-navy-800 hover:border-navy-600 hover:bg-navy-50"
              >
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Physicians -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <SectionHeading
      title="Physicians and optometrists who know their patients"
      intro="Surgeons and optometrists working together in one practice, so your care stays coordinated."
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {doctors.slice(0, 3).map((d) => <DoctorCard doctor={d} />)}
    </div>
    <div class="mt-8 text-center">
      <a href="/doctors/" class="inline-flex items-center gap-1.5 text-lg font-semibold text-navy-700 hover:underline">
        Meet all of our doctors
        <Icon name="ph:arrow-right" class="h-5 w-5" aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- Regional service + referring providers, one combined band -->
  <section class="bg-navy-50">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-3xl font-semibold text-navy-900">Serving the Big Country</h2>
        <p class="mt-4 max-w-xl text-lg text-ink-soft">
          Patients come to us from across the region. If you are traveling for a visit, we will help
          you plan appointments efficiently.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2.5">
          {
            practice.serviceArea.map((city) => (
              <li class="rounded-full bg-white px-4 py-1.5 font-medium text-navy-800">{city}</li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-lg border border-sand-200 bg-white p-7">
        <h2 class="font-serif text-2xl font-semibold text-navy-900">For referring providers</h2>
        <p class="mt-3 text-ink-soft">
          We work alongside optometrists and physicians throughout the region, and we return your
          patients to you with clear reports after treatment.
        </p>
        <a
          href="/referring-providers/"
          class="mt-5 inline-flex items-center gap-1.5 font-semibold text-navy-700 hover:underline"
        >
          Refer a patient
          <Icon name="ph:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- Patient resources -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <SectionHeading
      title="Already a patient?"
      intro="Secure tools open in the practice's protected external systems, separate from this website."
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <a href={practice.links.patientPortal} class="rounded-lg border border-sand-200 bg-white p-5 hover:border-navy-600">
        <span class="flex items-center gap-2 font-semibold text-navy-900">
          <Icon name="ph:lock-simple" class="h-5 w-5 text-sage-700" aria-hidden="true" />
          Patient Portal
        </span>
        <p class="mt-1.5 text-sm text-ink-soft">Secure external system</p>
      </a>
      <a href={practice.links.payBill} class="rounded-lg border border-sand-200 bg-white p-5 hover:border-navy-600">
        <span class="flex items-center gap-2 font-semibold text-navy-900">
          <Icon name="ph:credit-card" class="h-5 w-5 text-sage-700" aria-hidden="true" />
          Pay Your Bill
        </span>
        <p class="mt-1.5 text-sm text-ink-soft">Secure external system</p>
      </a>
      <a href="/patient-resources/" class="rounded-lg border border-sand-200 bg-white p-5 hover:border-navy-600">
        <span class="flex items-center gap-2 font-semibold text-navy-900">
          <Icon name="ph:folder-user" class="h-5 w-5 text-sage-700" aria-hidden="true" />
          Forms & Resources
        </span>
        <p class="mt-1.5 text-sm text-ink-soft">Information pages on this site</p>
      </a>
    </div>
  </section>

  <!-- Reputation: honest placeholder, never fabricated -->
  <section class="border-t border-sand-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
      <p class="font-serif text-6xl leading-none text-sage-600/40" aria-hidden="true">&ldquo;</p>
      <h2 class="font-serif text-3xl font-semibold text-navy-900">What patients say</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-ink-soft">
        Verified patient feedback appears here once the practice authorizes it, linked to its live
        source. No reviews are ever reproduced without permission.
      </p>
      <p class="mt-6 text-xs uppercase tracking-[0.16em] text-ink-soft/60">
        Reserved for verified reviews
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
