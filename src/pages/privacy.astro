---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Notice | Abilene Eye Institute"
  description="Privacy information for the Abilene Eye Institute website demonstration."
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="font-serif text-4xl font-semibold text-navy-900">Privacy notice</h1>
    <div class="mt-6 space-y-5 text-lg text-ink-soft">
      <p>
        This is a demonstration website. It collects no personal information, no health
        information, and no payment information. It sets no advertising cookies, runs no tracking
        pixels, and uses no session recording.
      </p>
      <p>
        The vision-correction self-assessment runs entirely in your browser. Answers are never
        stored or transmitted, and they disappear when you leave the page.
      </p>
      <p>
        The production website's full privacy notice, including the practice's Notice of Privacy
        Practices, will be prepared with the practice and its counsel before launch.
      </p>
    </div>
  </section>
</BaseLayout>
