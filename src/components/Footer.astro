---
import { practice } from '../data/practice';
const year=new Date().getFullYear();
---
<footer class="bg-navy-900 text-navy-100">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
    <div><img src={practice.assets.logo} alt="Abilene Eye Institute" class="h-14 rounded bg-white p-1" /><address class="mt-5 not-italic">{practice.address.street}<br />{practice.address.city}, {practice.address.state} {practice.address.zip}</address><p class="mt-3"><a href={practice.phone.href} class="font-semibold text-white">{practice.phone.display}</a><br /><span class="text-sm">Fax {practice.fax.display}</span></p></div>
    <div><h2 class="text-sm font-semibold uppercase tracking-wider text-white">Office hours</h2><dl class="mt-4 space-y-2 text-sm">{practice.hours.map(h=><div><dt class="font-semibold text-white">{h.days}</dt><dd>{h.hours}</dd></div>)}</dl></div>
    <nav aria-label="Patient links"><h2 class="text-sm font-semibold uppercase tracking-wider text-white">Patient shortcuts</h2><ul class="mt-4 space-y-2.5"><li><a href={practice.links.patientForms} class="hover:text-white hover:underline">Patient Forms</a></li><li><a href={practice.links.payBill} class="hover:text-white hover:underline">Pay Your Bill</a></li><li><a href={practice.links.financing} class="hover:text-white hover:underline">Financing Options</a></li><li><a href="/doctors/" class="hover:text-white hover:underline">Meet the Doctors</a></li><li><a href="/locations/" class="hover:text-white hover:underline">Directions</a></li></ul></nav>
    <div class="text-sm"><h2 class="text-sm font-semibold uppercase tracking-wider text-white">Important</h2><p class="mt-4"><strong class="text-white">For a medical emergency, call 911.</strong> For sudden vision loss, eye injury, or severe eye pain, seek immediate care.</p><p class="mt-4">This site provides general information, not medical advice.</p><ul class="mt-4 space-y-2"><li><a href="/privacy/" class="underline">Privacy</a></li><li><a href="/accessibility/" class="underline">Accessibility</a></li></ul></div>
  </div>
  <div class="border-t border-navy-700"><div class="mx-auto max-w-7xl px-4 py-5 text-xs text-navy-100/70 sm:px-6"><p>© {year} Abilene Eye Institute. Concept demo by Agavi AI LLC; not the live practice website. No patient information is collected.</p></div></div>
</footer>
