---
import { practice } from '../data/practice';

const year = new Date().getFullYear();
const { logoOnDark } = practice.assets;

const patientLinks = [
  { label: 'Patient Resources', href: '/patient-resources/' },
  { label: 'Patient Forms', href: practice.links.patientForms },
  { label: 'Pay Your Bill', href: practice.links.payBill },
  { label: 'Financing Options', href: practice.links.financing },
];

const practiceLinks = [
  { label: 'About the Practice', href: '/about/' },
  { label: 'Our Doctors', href: '/doctors/' },
  { label: 'Location & Directions', href: '/locations/' },
  { label: 'Referring Providers', href: '/referring-providers/' },
];
---

<footer class="bg-navy-900 text-navy-100">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <img
        src={logoOnDark.src}
        alt={logoOnDark.alt}
        width={logoOnDark.width}
        height={logoOnDark.height}
        loading="lazy"
        class="h-12 w-auto"
      />
      <address class="mt-5 not-italic leading-relaxed">
        {practice.address.street}<br />
        {practice.address.city}, {practice.address.state} {practice.address.zip}
      </address>
      <p class="mt-3">
        <a href={practice.links.call} class="font-semibold text-white hover:underline">{practice.phone.display}</a>
        <br />
        <span class="text-sm">Fax {practice.fax.display}</span>
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Office hours</h2>
      <dl class="mt-4 space-y-2 text-sm">
        {
          practice.hours.map((h) => (
            <div>
              <dt class="font-semibold text-white">{h.days}</dt>
              <dd>{h.hours}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <nav aria-label="Patient and practice links">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">For patients</h2>
      <ul class="mt-4 space-y-2.5">
        {patientLinks.map((l) => <li><a href={l.href} class="hover:text-white hover:underline">{l.label}</a></li>)}
      </ul>
      <h2 class="mt-8 text-sm font-semibold uppercase tracking-wider text-white">Practice</h2>
      <ul class="mt-4 space-y-2.5">
        {practiceLinks.map((l) => <li><a href={l.href} class="hover:text-white hover:underline">{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="text-sm leading-relaxed">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Important</h2>
      <p class="mt-4">
        <strong class="text-white">If you are experiencing a medical emergency, call 911.</strong>
        For sudden vision loss, eye injury, or severe eye pain, seek immediate medical care.
      </p>
      <p class="mt-4">This website provides general information and does not offer medical advice.</p>
      <ul class="mt-4 space-y-2">
        <li><a href="/notices/" class="underline hover:text-white">Patient notices and language assistance</a></li>
        <li><a href="/privacy/" class="underline hover:text-white">Website privacy</a></li>
        <li><a href="/accessibility/" class="underline hover:text-white">Accessibility statement</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-700">
    <div class="mx-auto max-w-7xl px-4 py-5 text-xs text-navy-100 sm:px-6">
      <p>&copy; {year} Abilene Eye Institute. All rights reserved.</p>
      <p class="mt-1">
        Concept demonstration prepared by Agavi AI LLC. This is not the practice's live website and
        it collects no patient information.
      </p>
    </div>
  </div>
</footer>
