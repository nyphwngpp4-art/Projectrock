---
interface Props {
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}
const { title, intro, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  <h2 class="font-serif text-3xl font-semibold text-navy-900 sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-lg text-ink-soft">{intro}</p>}
</div>
