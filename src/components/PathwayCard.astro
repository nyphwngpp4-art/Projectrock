---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  cta: string;
}
const { title, description, href, icon, cta } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-lg border border-sand-200 bg-white p-6 transition-shadow hover:shadow-md hover:shadow-navy-100"
>
  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-sage-50 text-sage-700" aria-hidden="true">
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <h3 class="mt-4 font-serif text-xl font-semibold text-navy-900">{title}</h3>
  <p class="mt-2 flex-1 text-ink-soft">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 font-semibold text-navy-700 group-hover:underline">
    {cta}
    <Icon name="ph:arrow-right" class="h-4 w-4" aria-hidden="true" />
  </span>
</a>
