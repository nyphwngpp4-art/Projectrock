---
import { Icon } from 'astro-icon/components';
import { practice } from '../data/practice';

const nav = [
  { label: 'Services', href: '/services/' },
  { label: 'Cataracts', href: '/cataract-care/' },
  { label: 'Vision Correction', href: '/vision-correction/' },
  { label: 'Doctors', href: '/doctors/' },
  { label: 'Patient Resources', href: '/patient-resources/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/locations/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<!-- Utility bar: one phone number lives in the header CTA; this bar carries
     the everyday patient shortcuts. Wrapped in a nav so it sits in a landmark. -->
<nav aria-label="Patient shortcuts" class="bg-navy-900 text-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 text-sm sm:px-6">
    <p class="hidden sm:block">Serving Abilene and the Big Country since {practice.foundingYear}</p>
    <ul class="ml-auto flex items-center gap-5">
      <li><a href={practice.links.patientForms} class="hover:underline">Patient Forms</a></li>
      <li><a href={practice.links.payBill} rel="noopener" class="hover:underline">Pay Bill</a></li>
      <li class="hidden sm:block"><a href="/referring-providers/" class="hover:underline">Referring Providers</a></li>
    </ul>
  </div>
</nav>

<header class="sticky top-0 z-40 border-b border-sand-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:h-[76px]">
    <!-- Typeset wordmark: the practice's logo file is white-on-transparent, so
         it appears on the navy footer instead of this white header. -->
    <a href="/" class="flex items-center gap-2.5" aria-label="Abilene Eye Institute home">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-navy-800 text-white" aria-hidden="true">
        <Icon name="ph:eye" class="h-5 w-5" />
      </span>
      <span class="leading-tight">
        <span class="block font-serif text-lg font-semibold text-navy-900">Abilene Eye Institute</span>
        <span class="block text-xs tracking-wide text-ink-soft">Cataract &amp; LASIK Surgery Center</span>
      </span>
    </a>

    <nav aria-label="Main navigation" class="hidden lg:block">
      <ul class="flex items-center gap-5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'whitespace-nowrap text-[0.95rem] font-medium text-ink hover:text-navy-700',
                  isActive(item.href) && 'text-navy-700 underline decoration-2 underline-offset-8',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={practice.links.call}
        class="hidden items-center gap-2 rounded-md bg-navy-800 px-5 py-2.5 text-[0.95rem] font-semibold text-white hover:bg-navy-700 md:inline-flex"
      >
        <Icon name="ph:phone" class="h-4 w-4" aria-hidden="true" />
        Call {practice.phone.display}
      </a>
      <a
        href={practice.links.call}
        class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-sage-50 text-sage-700 md:hidden"
        aria-label={`Call Abilene Eye Institute at ${practice.phone.display}`}
      >
        <Icon name="ph:phone" class="h-5 w-5" aria-hidden="true" />
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-sand-300 text-navy-900 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <Icon name="ph:list" class="h-6 w-6" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile navigation" class="hidden border-t border-sand-200 bg-white lg:hidden">
    <ul class="space-y-1 px-4 py-4">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="block rounded-md px-3 py-3 text-lg font-medium text-ink hover:bg-sand-100"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a href={practice.links.call} class="block rounded-md bg-navy-800 px-3 py-3 text-center text-lg font-semibold text-white">
          Call {practice.phone.display}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // The only global JS on the site: an accessible mobile menu toggle.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
    const label = toggle.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Open menu' : 'Close menu';
  });
</script>
