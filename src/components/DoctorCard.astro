---
import type { Doctor } from '../data/doctors';
interface Props { doctor: Doctor }
const { doctor } = Astro.props;
---
<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-sand-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
  <div class="aspect-[4/3] overflow-hidden bg-navy-50">
    <img src={doctor.image} alt={`${doctor.name}, ${doctor.degree}`} class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-700">{doctor.role}</p>
    <h3 class="mt-2 font-serif text-2xl font-semibold text-navy-900">{doctor.name}, {doctor.degree}</h3>
    <p class="mt-3 flex-1 text-ink-soft">{doctor.cardLine}</p>
    <a href={`/doctors/${doctor.slug}/`} class="mt-5 font-semibold text-navy-700 hover:underline">Meet {doctor.name.split(' ')[0]} <span aria-hidden="true">→</span></a>
  </div>
</article>
