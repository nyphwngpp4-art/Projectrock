---
import type { Doctor } from '../data/doctors';

interface Props {
  doctor: Doctor;
}
const { doctor } = Astro.props;
const initials = doctor.name
  .split(' ')
  .filter((w) => w.length > 1)
  .map((w) => w[0])
  .join('');
---

<article class="flex h-full flex-col rounded-lg border border-sand-200 bg-white p-6 text-center">
  <!-- Photography placeholder: swap for a real headshot; see ASSET-INVENTORY.md -->
  <div
    class="mx-auto flex h-28 w-28 items-center justify-center rounded-full bg-navy-50 font-serif text-3xl font-semibold text-navy-700"
    role="img"
    aria-label={`Portrait placeholder for ${doctor.name}, ${doctor.degree}`}
  >
    {initials}
  </div>
  <h3 class="mt-4 font-serif text-xl font-semibold text-navy-900">
    {doctor.name}, {doctor.degree}
  </h3>
  <p class="mt-1 text-sm font-medium text-sage-700">{doctor.role}</p>
  <p class="mt-3 flex-1 text-[0.95rem] text-ink-soft">{doctor.cardLine}</p>
  <a
    href={`/doctors/${doctor.slug}/`}
    class="mt-4 font-semibold text-navy-700 hover:underline"
  >
    View profile<span class="sr-only"> for {doctor.name}, {doctor.degree}</span>
  </a>
</article>
