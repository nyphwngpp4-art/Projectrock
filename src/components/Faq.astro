---
import { Icon } from 'astro-icon/components';

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-sand-200 rounded-lg border border-sand-200 bg-white">
  {
    items.map((item) => (
      <details class="group px-5 py-4">
        <summary class="flex items-center justify-between gap-4 text-lg font-semibold text-navy-900">
          {item.q}
          <Icon
            name="ph:caret-down"
            class="h-5 w-5 shrink-0 text-navy-700 transition-transform group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <p class="mt-3 text-ink-soft">{item.a}</p>
      </details>
    ))
  }
</div>
